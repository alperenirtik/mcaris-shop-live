# MCARIS E-Ticaret Canlı Production Yapılandırma Dosyası (.env)

# 1. PostgreSQL Veritabanı Bağlantısı
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mcaris_shop"

# 2. iyzico 3D Secure Sanal POS Entegrasyonu
# Canlı: https://api.iyzipay.com (Test: https://sandbox-api.iyzipay.com)
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://api.iyzipay.com"

# 3. Web3Forms İletişim Formu Anahtarı
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY="4bf40ade-771b-4cf9-ac9b-055a78543c1d"

# 4. Müşteri & Admin JWT Oturum Anahtarı
JWT_SECRET="mcaris-super-secret-jwt-key-change-in-prod-2026"

# 5. Canlı Site URL'si
NEXT_PUBLIC_BASE_URL="https://shop.mcaris.com.tr"

# 6. SMTP E-Posta Yapılandırması (cPanel Webmail)
SMTP_HOST="mail.mcaris.com.tr"
SMTP_PORT="465"
SMTP_USER="info@mcaris.com.tr"
SMTP_PASS="cpanel-eposta-sifreniz"
SMTP_FROM_NAME="MCARIS Medikal"

# 7. Sipariş Bildirim E-Postası (Yeni siparişlerin gönderileceği adres)
ORDER_NOTIFICATION_EMAIL="info@mcaris.com.tr"

# 8. Resend E-Posta Servisi (Yedek — SMTP başarısız olursa devreye girer, opsiyonel)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="MCARIS Medikal <info@mcaris.com.tr>"

# 9. PayTR Sanal POS (iFrame API) Entegrasyonu
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
PAYTR_TEST_MODE="0" # Canlı: 0, Test: 1


# SEO panel → shop Pazarama API relay (Cloudflare IP bypass)
MCARIS_PAZARAMA_RELAY_SECRET=""

# SEO panel → shop fiyat/stok (yoksa MCARIS_PAZARAMA_RELAY_SECRET kullanılır)
MCARIS_PRICE_STOCK_SECRET=""
